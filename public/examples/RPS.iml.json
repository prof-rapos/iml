            "trigger": "timer.timeout",
            "guard": "",
            "effect": "log.log(\"\\nGame Over!\");\nlog.log(players.get(0).getName() + \": \" + players.get(0).getGamesWon());\nlog.log(players.get(1).getName() + \": \" + players.get(1).getGamesWon());\nString winner = (players.get(0).getGamesWon() > players.get(1).getGamesWon()) ? players.get(0).getName() : players.get(1).getName();\nlog.log(winner + \" wins!\");",
