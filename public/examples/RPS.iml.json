            "trigger": "player1.sendMove",
            "guard": "",
            "effect": "log.log(\"\");\r\nlog.log(\"Round \" + (gamesPlayed + 1) + \":\");\r\np1Move = move;\r\nlog.log(\"  \" + players.get(0).getName() + \" plays \" + p1Move);",
            "sourceHandle": "bottom",
            "targetHandle": "right",
            "labelT": 0.6333333333333333
          },
          {
            "id": "TTCtgs00",
            "source": "rgWb9Vx1",
            "target": "S7Q1AzgO",
            "trigger": "player2.sendMove",
            "guard": "",
            "effect": "p2Move = move;\r\nlog.log(\"  \" + players.get(1).getName() + \" plays \" + p2Move);\r\n\r\nint winner = 0;\r\n\r\nif      (p1Move.equals(\"R\") && p2Move.equals(\"S\")) winner = 1;\r\nelse if (p1Move.equals(\"P\") && p2Move.equals(\"R\")) winner = 1;\r\nelse if (p1Move.equals(\"S\") && p2Move.equals(\"P\")) winner = 1;\r\nelse if (p1Move.equals(\"R\") && p2Move.equals(\"P\")) winner = 2;\r\nelse if (p1Move.equals(\"P\") && p2Move.equals(\"S\")) winner = 2;\r\nelse if (p1Move.equals(\"S\") && p2Move.equals(\"R\")) winner = 2;\r\n\r\nif (!p1Move.equals(p2Move)) gamesPlayed++;\r\n\r\n\r\nif (winner == 1) {\r\n    players.get(0).setGamesWon(players.get(0).getGamesWon() + 1);\r\n    log.log(players.get(0).getName() + \" wins the round.\");\r\n} else if (winner == 2) {\r\n    players.get(1).setGamesWon(players.get(1).getGamesWon() + 1);\r\n    log.log(players.get(1).getName() + \" wins the round.\");\r\n}",
            "sourceHandle": "left",
            "targetHandle": "bottom",
            "labelT": 0.65
          }
